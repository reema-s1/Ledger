DATABASE_URL=postgres://ledger:ledger@localhost:5434/ledger

# live | replay (default: replay)
# Set to replay in production/on the deployed demo, so the URL always
# shows a living market — a design choice, documented in the README, not
# an apology.
DATA_MODE=replay

# 1 to enable (default: off). Playback (the scrubbable-history page) is
# the highest-risk addition this late — off by default so it can be left
# off entirely, or flipped on, without touching any other route.
# ENABLE_PLAYBACK=1

# 1 to enable (default: off). "Find possible explanation" — an on-demand,
# search-grounded LLM lookup for a flagged move (see README). Needs
# OPENROUTER_API_KEY below to actually work once enabled.
# ENABLE_EXPLANATION_LOOKUP=1

# 1 to enable (default: off). Ask the log's two LLM-assisted layers (see
# README): a second attempt at parsing a question the deterministic
# parser found nothing in, and rephrasing the deterministic answer into
# more natural prose (verified against the original before it's shown).
# The answer's underlying facts are never LLM-written either way — see
# src/lib/ask-log.ts. Needs OPENROUTER_API_KEY below once enabled.
# ENABLE_ASK_LOG_LLM=1

# Free at https://openrouter.ai — no payment method needed for the free
# model (src/lib/openrouter.ts) both ENABLE_EXPLANATION_LOOKUP and
# ENABLE_ASK_LOG_LLM use.
# OPENROUTER_API_KEY=

# --- Production (Neon) ---
# Neon connection strings need sslmode=require and, for serverless
# functions (Vercel), the pooled connection string (look for "-pooler" in
# the host) rather than the direct one:
# DATABASE_URL=postgres://<user>:<password>@<host>-pooler.neon.tech/<db>?sslmode=require
